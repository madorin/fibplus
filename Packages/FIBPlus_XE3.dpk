  IB_Intf in '..\Source\IB_Intf.pas',
  IB_InstallHeader in '..\Source\IB_InstallHeader.pas',
  FIBSafeTimer in '..\Source\FIBSafeTimer.pas',
  IBBlobFilter in '..\Source\IBBlobFilter.pas',
  IB_Externals in '..\Source\IB_Externals.pas',
  pFIBDataInfo in '..\Source\pFIBDataInfo.pas',
  pFIBEventLists in '..\Source\pFIBEventLists.pas',
  FIBMiscellaneous in '..\Source\FIBMiscellaneous.pas',
  pFIBCacheQueries in '..\Source\pFIBCacheQueries.pas',
  fib in '..\Source\fib.pas',
  SIBEABase in '..\Source\SIBEABase.pas',
  pFIBDataSet in '..\Source\pFIBDataSet.pas',
  DSContainer in '..\Source\DSContainer.pas',
  pFIBExports in '..\Source\pFIBExports.pas',
  VariantRtn in '..\Source\VariantRtn.pas',
  FIBSQLMonitor in '..\Source\FIBSQLMonitor.pas',
  pFIBInterfaces in '..\Source\pFIBInterfaces.pas',
  pFIBSQLLog in '..\Source\pFIBSQLLog.pas',
  RegUtils in '..\Source\RegUtils.pas',
  StrUtil in '..\Source\StrUtil.pas',
  FIBQuery in '..\Source\FIBQuery.pas',
  FIBDataSet in '..\Source\FIBDataSet.pas',
  FIBCacheManage in '..\Source\FIBCacheManage.pas',
  pTestInfo in '..\Source\pTestInfo.pas',
  SqlTxtRtns in '..\Source\SqlTxtRtns.pas',
  DBParsers in '..\Source\DBParsers.pas',
  pFIBMetaData in '..\Source\pFIBMetaData.pas',
  pFIBQuery in '..\Source\pFIBQuery.pas',
  FIBConsts in '..\Source\FIBConsts.pas',
  pFIBScripter in '..\Source\pFIBScripter.pas',
  pFIBProps in '..\Source\pFIBProps.pas',
  pFIBClientDataSet in '..\Source\pFIBClientDataSet.pas',
  pFIBErrorHandler in '..\Source\pFIBErrorHandler.pas',
  pFIBDataRefresh in '..\Source\pFIBDataRefresh.pas',
  pFIBArray in '..\Source\pFIBArray.pas',
  pFIBLists in '..\Source\pFIBLists.pas',
  pFIBStoredProc in '..\Source\pFIBStoredProc.pas',
  IB_ErrorCodes in '..\Source\IB_ErrorCodes.pas',
  RegFIBPlus in '..\Source\RegFIBPlus.pas',
  FIBCloneComponents in '..\Source\FIBCloneComponents.pas',
  pFIBFieldsDescr in '..\Source\pFIBFieldsDescr.pas',
  SIBAPI in '..\Source\SIBAPI.pas',
  SIBFIBEA in '..\Source\SIBFIBEA.PAS',
