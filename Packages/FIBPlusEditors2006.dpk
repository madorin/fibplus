package FIBPlusEditors2006;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'FIBPlus Property Editors'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}

requires
  vcl,
  vcldb,
  vclx,
  designide,
  FIBPlus2006,
  rtl,
  dbrtl,
  vclactnband,
  dsnap,
  xmlrtl,
  VclSmp;

contains
  RegFIBPlusEditors in '..\Source\Editors\RegFIBPlusEditors.pas',
  EdFieldInfo in '..\Source\Editors\EdFieldInfo.pas' {frmFields},
  EdDataSetInfo in '..\Source\Editors\EdDataSetInfo.pas' {frmEdDataSetInfo},
  FIBDBEdit in '..\Source\Editors\FIBDBEdit.pas' {DBEditForm},
  FIBTrEdit in '..\Source\Editors\FIBTrEdit.pas' {frmTransEdit},
  FIBConditionsEdit in '..\Source\Editors\FIBConditionsEdit.pas' {frmEditCheckStrings},
  FIBAutoUpdEditor in '..\Source\Editors\FIBAutoUpdEditor.pas' {FIBAutoUpdateOptionForm},
  FIBDataSetOptions in '..\Source\Editors\FIBDataSetOptions.pas' {FPDataSetOptionsForm},
  EdParamToFields in '..\Source\Editors\EdParamToFields.pas' {frmEdParamToFields},
  fraSQLEdit in '..\Source\Editors\fraSQLEdit.pas' {fSQLEdit: TFrame},
  fraDSSQLEdit in '..\Source\Editors\fraDSSQLEdit.pas' {fDSSQLEdit: TFrame},
  fraAutoUpdEditor in '..\Source\Editors\fraAutoUpdEditor.pas' {fAutoUpdateOptionForm: TFrame},
  fraConditionsEdit in '..\Source\Editors\fraConditionsEdit.pas' {fraEdConditions: TFrame},
  FIBSQLEditor in '..\Source\Editors\FIBSQLEditor.pas' {frmSQLEdit},
  FIBDataSQLEditor in '..\Source\Editors\FIBDataSQLEditor.pas' {frmDstSQLedit},
  EdErrorInfo in '..\Source\Editors\EdErrorInfo.pas' {frmErrors},
  ToCodeEditor in '..\Source\Editors\ToCodeEditor.pas',
  ToCodeEditorIntfs in '..\Source\Editors\ToCodeEditorIntfs.pas',
  FIBSyntaxMemo in '..\Source\Editors\FIBSyntaxMemo.pas',
  IBSQLSyn in '..\Source\Editors\IBSQLSyn.pas',
  FIBEditorsConsts in '..\Source\Editors\FIBEditorsConsts.pas',
  RegistryUtils in '..\Source\Editors\RegistryUtils.pas',
  RegSynEditAlt in '..\Source\Editors\RegSynEditAlt.pas',
  RTTIRoutines in '..\Source\Editors\RTTIRoutines.pas',
  FIBComponentEditors in '..\Source\Editors\FIBComponentEditors.pas',
  FIBRepositoryOperations in '..\Source\Editors\FIBRepositoryOperations.pas',
  uFIBScriptForm in '..\Source\Editors\uFIBScriptForm.pas',
  FIBToolsConsts in '..\Source\Editors\FIBToolsConsts.pas',
  FindCmp in '..\Source\Editors\FindCmp.pas',
  FIBPreferences in '..\Source\Editors\FIBPreferences.pas',
  uFrmSearchResult in '..\Source\Editors\uFrmSearchResult.pas';

end.
