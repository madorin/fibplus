// The requires clause is edited by hand: the Project Manager drops its IFDEF branches
package FIBTools;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE RELEASE}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'FIBPlus IDE Tools'}
{$DESIGNONLY}
{$LIBSUFFIX AUTO}
{$IMPLICITBUILD OFF}

requires
  rtl,
  vcl,
  vclimg,
  designide,
{$IFDEF VER370}
  FIBPlus_D37,
  FIBPlusEditors_D37
{$ENDIF}
{$IFDEF VER360}
  FIBPlus_D29,
  FIBPlusEditors_D29
{$ENDIF}
{$IFDEF VER350}
  FIBPlus_D28,
  FIBPlusEditors_D28
{$ENDIF}
{$IFDEF VER340}
  FIBPlus_D27,
  FIBPlusEditors_D27
{$ENDIF};

contains
  RegFIBTools in '..\Source\Tools\RegFIBTools.pas',
  FIBAbout in '..\Source\Tools\FIBAbout.pas' {FIBAboutForm},
  FIBPreferences in '..\Source\Tools\FIBPreferences.pas' {FIBPreferencesForm},
  FIBToolsConsts in '..\Source\Tools\FIBToolsConsts.pas';

end.
