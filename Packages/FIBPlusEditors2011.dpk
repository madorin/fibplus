package FIBPlusEditors2011;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'FIBPlus Property Editors'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}

requires
  vcl,
  vcldb,
  vclx,
  designide,
  rtl,
  dbrtl,
  vclactnband,
  fibplus2011;

contains
  RegFIBPlusEditors in '..\Source\Editors\RegFIBPlusEditors.pas',
  EdFieldInfo in '..\Source\Editors\EdFieldInfo.pas' {frmFields},
  EdDataSetInfo in '..\Source\Editors\EdDataSetInfo.pas' {frmEdDataSetInfo},
  pFIBDBEdit in '..\Source\Editors\pFIBDBEdit.pas' {DBEditForm},
  pFIBTrEdit in '..\Source\Editors\pFIBTrEdit.pas' {frmTransEdit},
  pFIBConditionsEdit in '..\Source\Editors\pFIBConditionsEdit.pas' {frmEditCheckStrings},
  pFIBAutoUpdEditor in '..\Source\Editors\pFIBAutoUpdEditor.pas' {pFIBAutoUpdateOptionForm},
  pFIBDataSetOptions in '..\Source\Editors\pFIBDataSetOptions.pas' {FPDataSetOptionsForm},
  EdParamToFields in '..\Source\Editors\EdParamToFields.pas' {frmEdParamToFields},
  fraSQLEdit in '..\Source\Editors\fraSQLEdit.pas' {fSQLEdit: TFrame},
  fraDSSQLEdit in '..\Source\Editors\fraDSSQLEdit.pas' {fDSSQLEdit: TFrame},
  fraAutoUpdEditor in '..\Source\Editors\fraAutoUpdEditor.pas' {fAutoUpdateOptionForm: TFrame},
  fraConditionsEdit in '..\Source\Editors\fraConditionsEdit.pas' {fraEdConditions: TFrame},
  FIBSQLEditor in '..\Source\Editors\FIBSQLEditor.pas' {frmSQLEdit},
  FIBDataSQLEditor in '..\Source\Editors\FIBDataSQLEditor.pas' {frmDstSQLedit},
  EdErrorInfo in '..\Source\Editors\EdErrorInfo.pas' {frmErrors},
  ToCodeEditor in '..\Source\Editors\ToCodeEditor.pas',
  ToCodeEditorIntfs in '..\Source\Editors\ToCodeEditorIntfs.pas',
  RTTIRoutines in '..\Source\Editors\RTTIRoutines.pas',
  pFIBComponentEditors in '..\Source\Editors\pFIBComponentEditors.pas',
  pFIBEditorsConsts in '..\Source\Editors\pFIBEditorsConsts.pas',
  pFIBRepositoryOperations in '..\Source\Editors\pFIBRepositoryOperations.pas',
  RegistryUtils in '..\Source\Editors\RegistryUtils.pas',
  RegSynEditAlt in '..\Source\Editors\RegSynEditAlt.pas',
  uFIBScriptForm in '..\Source\Editors\uFIBScriptForm.pas' {frmScript},
  IBSQLSyn in '..\Source\Editors\IBSQLSyn.pas',
  FindCmp in '..\Source\Editors\FindCmp.pas',
  pFIBPreferences in '..\Source\Editors\pFIBPreferences.pas' {frmFIBPreferences},
  uFrmSearchResult in '..\Source\Editors\uFrmSearchResult.pas' {frmCompSearchResult},
  FIBToolsConsts in '..\Source\Editors\FIBToolsConsts.pas',
  uFontEditor in '..\Source\Editors\uFontEditor.pas' {frmFontEditor};

end.

