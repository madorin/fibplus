package FIBPlus6;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'FIBPlus'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}
{$WARN UNIT_DEPRECATED OFF}

requires
  vcl,
  vcldb,
  dsnap;

contains
  RegFIBPlus in '..\Source\RegFIBPlus.pas',
  DSContainer in '..\Source\DSContainer.pas',
  FIB in '..\Source\fib.pas',
  FIBConsts in '..\Source\FIBConsts.pas',
  FIBDatabase in '..\Source\FIBDatabase.pas',
  FIBDataSet in '..\Source\FIBDataSet.pas',
  FIBMiscellaneous in '..\Source\FIBMiscellaneous.pas',
  FIBQuery in '..\Source\FIBQuery.pas',
  FIBSQLMonitor in '..\Source\FIBSQLMonitor.pas',
  IB_ErrorCodes in '..\Source\IB_ErrorCodes.pas',
  IB_Externals in '..\Source\IB_Externals.pas',
  IB_Install in '..\Source\IB_Install.pas',
  IB_InstallHeader in '..\Source\IB_InstallHeader.pas',
  IB_Intf in '..\Source\IB_Intf.pas',
  FIBServices in '..\Source\FIBServices.pas',
  IB_Services in '..\Source\IB_Services.pas',
  ibase in '..\Source\ibase.pas',
  FIBArray in '..\Source\FIBArray.pas',
  pFIBArray in '..\Source\pFIBArray.pas',
  pFIBDatabase in '..\Source\pFIBDatabase.pas',
  FIBDataInfo in '..\Source\FIBDataInfo.pas',
  pFIBDataSet in '..\Source\pFIBDataSet.pas',
  FIBErrorHandler in '..\Source\FIBErrorHandler.pas',
  pFIBErrorHandler in '..\Source\pFIBErrorHandler.pas',
  FIBProps in '..\Source\FIBProps.pas',
  pFIBProps in '..\Source\pFIBProps.pas',
  pFIBQuery in '..\Source\pFIBQuery.pas',
  RegUtils in '..\Source\RegUtils.pas',
  SqlTxtRtns in '..\Source\SqlTxtRtns.pas',
  StdFuncs in '..\Source\StdFuncs.pas',
  FIBTypes in '..\Source\FIBTypes.pas',
  FIBCharSets in '..\Source\FIBCharSets.pas',
  StrUtil in '..\Source\StrUtil.pas',
  VariantRtn in '..\Source\VariantRtn.pas',
  FIBStoredProc in '..\Source\FIBStoredProc.pas',
  pFIBStoredProc in '..\Source\pFIBStoredProc.pas',
  FIBFieldsDescr in '..\Source\FIBFieldsDescr.pas',
  FIBEventLists in '..\Source\FIBEventLists.pas',
  FIBCacheQueries in '..\Source\FIBCacheQueries.pas',
  SIBFIBEA in '..\Source\SIBFIBEA.PAS',
  SIBGlobals in '..\Source\SIBGlobals.pas',
  SIBEABase in '..\Source\SIBEABase.pas',
  SIBAPI in '..\Source\SIBAPI.pas',
  FIBTestInfo in '..\Source\FIBTestInfo.pas',
  FIBLists in '..\Source\FIBLists.pas',
  DBParsers in '..\Source\DBParsers.pas',
  FIBDBLoginDlg in '..\Source\FIBDBLoginDlg.pas' {frmFIBDBLoginDlg},
  IBBlobFilter in '..\Source\IBBlobFilter.pas',
  FIBCacheManage in '..\Source\FIBCacheManage.pas',
  FIBSQLLog in '..\Source\FIBSQLLog.pas',
  pFIBSQLLog in '..\Source\pFIBSQLLog.pas',
  FIBCloneComponents in '..\Source\FIBCloneComponents.pas',
  FIBInterfaces in '..\Source\FIBInterfaces.pas',
  FIBScripter in '..\Source\FIBScripter.pas',
  pFIBScripter in '..\Source\pFIBScripter.pas',
  FIBSafeTimer in '..\Source\FIBSafeTimer.pas',
  FIBMetaData in '..\Source\FIBMetaData.pas',
  pFIBMetaData in '..\Source\pFIBMetaData.pas',
  FIBExports in '..\Source\FIBExports.pas',
  FIBDataRefresh in '..\Source\FIBDataRefresh.pas',
  pFIBDataRefresh in '..\Source\pFIBDataRefresh.pas',
  FIBClientDataSet in '..\Source\FIBClientDataSet.pas',
  pFIBClientDataSet in '..\Source\pFIBClientDataSet.pas';

end.
