<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{761A3621-064E-4446-92AA-3B4BABC23EA5}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="FIBCore.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="FIBFMX.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="dclFIBCore.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="dclFIBTools.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="FIBCore">
        <MSBuild Projects="FIBCore.dproj"/>
    </Target>
    <Target Name="FIBCore:Clean">
        <MSBuild Projects="FIBCore.dproj" Targets="Clean"/>
    </Target>
    <Target Name="FIBCore:Make">
        <MSBuild Projects="FIBCore.dproj" Targets="Make"/>
    </Target>
    <Target Name="FIBFMX">
        <MSBuild Projects="FIBFMX.dproj"/>
    </Target>
    <Target Name="FIBFMX:Clean">
        <MSBuild Projects="FIBFMX.dproj" Targets="Clean"/>
    </Target>
    <Target Name="FIBFMX:Make">
        <MSBuild Projects="FIBFMX.dproj" Targets="Make"/>
    </Target>
    <Target Name="dclFIBCore">
        <MSBuild Projects="dclFIBCore.dproj"/>
    </Target>
    <Target Name="dclFIBCore:Clean">
        <MSBuild Projects="dclFIBCore.dproj" Targets="Clean"/>
    </Target>
    <Target Name="dclFIBCore:Make">
        <MSBuild Projects="dclFIBCore.dproj" Targets="Make"/>
    </Target>
    <Target Name="dclFIBTools">
        <MSBuild Projects="dclFIBTools.dproj"/>
    </Target>
    <Target Name="dclFIBTools:Clean">
        <MSBuild Projects="dclFIBTools.dproj" Targets="Clean"/>
    </Target>
    <Target Name="dclFIBTools:Make">
        <MSBuild Projects="dclFIBTools.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="FIBCore;FIBFMX;dclFIBCore;dclFIBTools"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="FIBCore:Clean;FIBFMX:Clean;dclFIBCore:Clean;dclFIBTools:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="FIBCore:Make;FIBFMX:Make;dclFIBCore:Make;dclFIBTools:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
